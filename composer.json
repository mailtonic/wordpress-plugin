{
    "name": "mailtonic/wordpress-plugin",
    "description": "mailtonic for WordPress: forms, popups, form-plugin bridges and WooCommerce sync.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=8.0"
    },
    "require-dev": {
        "phpunit/phpunit": "9.6.38",
        "yoast/phpunit-polyfills": "4.0.0",
        "wp-phpunit/wp-phpunit": "7.1.3",
        "roots/wordpress-no-content": "7.1.4",
        "wp-coding-standards/wpcs": "3.4.1",
        "dealerdirect/phpcodesniffer-composer-installer": "1.2.1"
    },
    "config": {
        "platform": { "php": "8.0.30" },
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "roots/wordpress-core-installer": true
        },
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit",
        "test:multisite": "WP_MULTISITE=1 phpunit --group multisite",
        "lint": "phpcs"
    }
}
