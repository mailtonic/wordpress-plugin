<?xml version="1.0"?>
<ruleset name="mailtonic">
	<description>WordPress Coding Standards for the mailtonic plugin.</description>
	<file>mailtonic.php</file>
	<file>uninstall.php</file>
	<file>includes</file>
	<file>blocks</file>
	<arg name="extensions" value="php"/>
	<arg value="sp"/>
	<arg name="colors"/>

	<config name="minimum_wp_version" value="6.5"/>
	<config name="testVersion" value="8.0-"/>

	<rule ref="WordPress">
		<!-- Class files follow class-<name>.php; namespaced classes keep short names. -->
		<exclude name="WordPress.Files.FileName.InvalidClassFileName"/>
	</rule>
	<rule ref="WordPress.Files.FileName.NotHyphenatedLowercase">
		<exclude-pattern>blocks/*/index.asset.php</exclude-pattern>
	</rule>
	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="mailtonic"/>
			</property>
		</properties>
	</rule>
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="mailtonic"/>
				<element value="Mailtonic"/>
			</property>
		</properties>
	</rule>
</ruleset>
